# Prisma reads these two names (map from Vercel Postgres vars — see README)
# DATABASE_URL  → pooled connection  (Vercel: arsh_DATABASE_URL)
# DIRECT_URL    → direct connection  (Vercel: arsh_POSTGRES_URL or arsh_PRISMA_DATABASE_URL)

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Required on production — used for sitemap, robots, RSS, and Open Graph URLs
# NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Optional — salt for comment IP hashing
# COMMENT_HASH_SALT="change-me-in-production"
