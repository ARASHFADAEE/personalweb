# Local / VPS (SQLite file next to the app)
DATABASE_URL="file:../db/custom.db"

# Vercel/serverless: SQLite paths are unreliable — use Turso, Neon, or Vercel Postgres instead.
# DATABASE_URL="libsql://your-db.turso.io?authToken=..."

# Required on production — used for sitemap, robots, RSS, and Open Graph URLs
# NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Optional — salt for comment IP hashing
# COMMENT_HASH_SALT="change-me-in-production"
