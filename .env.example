# Prisma reads these two names (map from Vercel Postgres vars — see README)
# DATABASE_URL  → pooled connection  (Vercel: arsh_DATABASE_URL / POSTGRES_PRISMA_URL) — app runtime
# DIRECT_URL    → direct connection  (Vercel: arsh_POSTGRES_URL / POSTGRES_URL_NON_POOLING) — migrations only
#
# CRITICAL: Do NOT put the migration/direct URL (role often named prisma_migration)
# into DATABASE_URL. That causes: "too many connections for role prisma_migration".
# Use the pooled URL for DATABASE_URL (often contains "-pooler" or is labeled Prisma/pooled).
#
# Schema changes: run `npm run db:push` locally (uses DIRECT_URL). Do NOT run db push on every Vercel build.

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Required on production — used for sitemap, robots, RSS, and Open Graph URLs
# NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Optional — salt for comment IP hashing
# COMMENT_HASH_SALT="change-me-in-production"

# Required on Vercel for media uploads (Storage → Blob → Connect Store)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
