// Prisma schema for Premium Persian RTL Developer Blog
// Database: PostgreSQL (Vercel Postgres / local Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth & Users
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN") // ADMIN | EDITOR
  bio          String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts  Post[]
  tokens Session[]

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Blog: Categories, Tags, Posts
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String? // accent color token e.g. "emerald"
  // SEO
  seoTitle       String?
  metaDescription String?
  // Meta
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]

  @@index([slug])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts PostTag[]

  @@index([slug])
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String // markdown content
  coverImage  String?
  status      String   @default("DRAFT") // DRAFT | PUBLISHED | SCHEDULED
  featured    Boolean  @default(false)
  publishedAt DateTime?
  scheduledAt DateTime?
  // Reading & analytics
  readingTime Int      @default(0) // minutes
  viewsCount  Int      @default(0)
  // Relations
  authorId   String
  categoryId String?
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       PostTag[]
  views      PostView[]
  comments   Comment[]
  // SEO fields
  seoTitle          String?
  metaDescription   String?
  canonicalUrl      String?
  ogTitle           String?
  ogDescription     String?
  ogImage           String?
  focusKeyword      String?
  robotsNoindex     Boolean @default(false)
  robotsNofollow    Boolean @default(false)
  // Meta
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([featured])
}

model Comment {
  id          String   @id @default(cuid())
  postId      String
  authorName  String
  authorEmail String?
  content     String
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  ipHash      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([status])
  @@index([createdAt])
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model PostView {
  id        String   @id @default(cuid())
  postId    String
  createdAt DateTime @default(now())
  // anonymous analytics (hashed for privacy)
  ipHash    String?
  userAgent String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Projects (Portfolio)
// ---------------------------------------------------------------------------

model Project {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  content      String? // markdown
  coverImage   String?
  technologies String   @default("[]") // JSON array of strings
  demoUrl      String?
  repoUrl      String?
  featured     Boolean  @default(false)
  status       String   @default("PUBLISHED") // DRAFT | PUBLISHED | ARCHIVED
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([featured])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Media Library
// ---------------------------------------------------------------------------

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  url          String
  altText      String?
  caption      String?
  mimeType     String
  size         Int // bytes
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Site Settings (key-value store)
// ---------------------------------------------------------------------------

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@index([key])
}
